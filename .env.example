# ──────────────────────────────────────────────────────────────
#  max-ekrom-bot — пример конфигурации.
#  Скопируйте в .env и заполните значения. .env в git НЕ попадает.
# ──────────────────────────────────────────────────────────────

# ── Telegram (бот для менеджеров) ─────────────────────────────
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Стартовый список менеджеров через запятую (узнать id: @userinfobot).
# При первом запуске копируется в data/managers.json; дальше список правится
# прямо из бота (кнопка «👥 Менеджеры» / уведомления о запросах доступа).
TELEGRAM_ALLOWED_IDS=
# user_id админов через запятую — кто может добавлять/удалять менеджеров из бота.
TELEGRAM_ADMIN_IDS=
# Прокси к api.telegram.org, если без VPN бот не стартует (РФ и др.)
# TELEGRAM_PROXY=socks5://127.0.0.1:10808

# ── LLM (разбор сообщений клиента) ────────────────────────────
# Провайдер: openai | groq | yandex | gigachat
LLM_PROVIDER=groq
# Модель. Для groq, напр.: openai/gpt-oss-120b (можно не задавать —
# подставится по умолчанию). Для openai, напр.: gpt-4o-mini.
LLM_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
# Groq (бесплатный тариф): ключ с https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Для российских провайдеров (заполняются при смене LLM_PROVIDER)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
GIGACHAT_AUTH_KEY=

# ── ekrom.ru ──────────────────────────────────────────────────
EKROM_BASE_URL=https://www.ekrom.ru
# Учётные данные партнёрского кабинета (используются скриптом разовой авторизации)
EKROM_LOGIN=
EKROM_PASSWORD=
# Путь к сохранённой сессии браузера (cookies после ручного входа)
EKROM_STORAGE_STATE=data/storage_state.json

# ── Поведение ─────────────────────────────────────────────────
# Запускать браузер с интерфейсом (true) или headless (false)
EKROM_HEADFUL=false
# Папка для скачанных PDF
OUTPUT_DIR=data/out
# Требовать подтверждение подобранных позиций у клиента перед генерацией PDF
REQUIRE_CONFIRMATION=true
# LLM-ре-ранк шортлиста подбора (#6): модель выбирает лучший товар из
# подходящих. true — точнее, но +1 вызов LLM на позицию; false — детерминированно.
LLM_RERANK=false

# ── Клиентский режим ──────────────────────────────────────────
# true — бот открыт всем (клиент пишет сам), PDF формируется своим шаблоном без
# корзины ekrom, лид уходит операторам. false — прежний режим «для менеджеров».
CLIENT_MODE=false
# Лимит запросов на одного клиента (защита бюджета LLM). 0 — без лимита.
CLIENT_RATE_PER_HOUR=8
CLIENT_RATE_PER_DAY=30
# Уведомлять операторов (TELEGRAM_ADMIN_IDS) о новом запросе клиента
NOTIFY_LEAD=true

# ── Кэш каталога (масштаб под поток) ──────────────────────────
# true — кандидаты для 6 базовых типов берём из локальной БД (data/catalog.db),
# наполняемой краулером (scripts/crawl_catalog.py), а не обходом сайта. Свежесть
# кэша — CATALOG_CACHE_TTL секунд (по умолчанию сутки).
USE_CATALOG_CACHE=false
CATALOG_CACHE_TTL=86400

# ── Брендинг клиентского PDF ──────────────────────────────────
SHOP_NAME=ekrom
# Контакты в подвале PDF (телефон/адрес)
SHOP_CONTACTS=
SHOP_SITE=https://www.ekrom.ru
# Путь к логотипу (png/jpg) для шапки PDF; пусто — без логотипа
PDF_LOGO_PATH=
# Путь к TTF-шрифту с кириллицей; пусто — ищем системный (DejaVu на сервере)
PDF_FONT_PATH=
